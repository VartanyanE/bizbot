# ---------------------------
# 🧠 Core Ignore Rules for BizBot
# ---------------------------

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.DS_Store

# --- Environment / Secrets ---
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# --- SQLite Database Files ---
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Build Output ---
dist/
build/
coverage/
.tmp/
.cache/
logs/
*.log

# --- Frontend (React) ---
client/node_modules/
client/build/
client/.env
client/.cache
client/.DS_Store

# --- Backend (Server) ---
server/node_modules/
server/.env
server/.cache
server/.DS_Store

# --- OS / IDE files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Misc ---
*.pid
*.seed
*.bak
*.tmp